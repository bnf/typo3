<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="EXT:hub/Resources/Private/Language/locallang_db.xlf" date="2022-08-15T20:22:32Z" product-name="hub">
    <header/>
    <body>
      <trans-unit id="hub">
        <source>Hub</source>
      </trans-unit>
      <trans-unit id="sys_app">
        <source>System Hub</source>
      </trans-unit>
      <trans-unit id="sys_app.name">
        <source>Name</source>
      </trans-unit>
      <trans-unit id="sys_app.name.description">
        <source>Meaningful name of the app</source>
      </trans-unit>
      <trans-unit id="sys_app.identifier">
        <source>Identifier</source>
      </trans-unit>
      <trans-unit id="sys_app.identifier.description">
        <source>This is your unique app identifier within the TYPO3 URL</source>
      </trans-unit>
      <trans-unit id="sys_app.secret">
        <source>Secret</source>
      </trans-unit>
      <trans-unit id="sys_app.secret.description">
        <source>The secret is hashed in db. The token will be shown once in a Notification when recreating a token.</source>
      </trans-unit>
      <trans-unit id="sys_app.secret.passwordGenerator">
        <source>Generate secret token</source>
      </trans-unit>
      <trans-unit id="sys_app.app_type">
        <source>App Type</source>
      </trans-unit>
      <trans-unit id="sys_hub.app_type.description">
        <source>Select the app type to be configured.</source>
      </trans-unit>
      <trans-unit id="sys_app.app_type.select">
        <source>Select a app</source>
      </trans-unit>
      <trans-unit id="sys_app.app_type.create_record">
        <source>Create database record</source>
      </trans-unit>
      <trans-unit id="sys_app.impersonate_user">
        <source>Impersonate User</source>
      </trans-unit>
      <trans-unit id="sys_app.impersonate_user.description">
        <source>Select the user with the appropriate access rights that is allowed to add a record of this type. If in doubt, use the CLI user.</source>
      </trans-unit>
      <trans-unit id="sys_app.table_name">
        <source>Table</source>
      </trans-unit>
      <trans-unit id="sys_app.table_name.description">
        <source>Select one tables to display the corresponding fields.</source>
      </trans-unit>
      <trans-unit id="sys_app.table_name.select">
        <source>Select a table</source>
      </trans-unit>
      <trans-unit id="sys_app.storage_pid">
        <source>Storage PID</source>
      </trans-unit>
      <trans-unit id="sys_app.storage_pid.description">
        <source>Select the page on which a new record is created on.</source>
      </trans-unit>
      <trans-unit id="sys_app.fields">
        <source>Fields</source>
      </trans-unit>
      <trans-unit id="sys_app.fields.description">
        <source>The available fields depend on the selected table. The usage of placeholders like ${foo.bar} is possible.</source>
      </trans-unit>
      <trans-unit id="palette.config">
        <source>Configuration</source>
      </trans-unit>
      <trans-unit id="palette.config.description">
        <source>General configuration of the app.</source>
      </trans-unit>
      <trans-unit id="palette.additional">
        <source>Additional configuration</source>
      </trans-unit>
      <trans-unit id="palette.additional.description">
        <source>Specific configuration for the selected app type</source>
      </trans-unit>
      <trans-unit id="fieldMapElement.noFields">
        <source>The selected table '%s' does not define any valid fields to be configured.</source>
      </trans-unit>
    </body>
  </file>
