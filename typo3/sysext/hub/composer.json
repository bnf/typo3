{
	"name": "typo3-suite/hub",
	"type": "typo3-cms-extension",
	"description": "TYPO3 CMS Hub - API for TYPO3",
	"homepage": "https://typo3.community/",
	"funding": [
		{
			"type": "membership",
			"url": "https://typo3.org/membership"
		}
	],
	"license": [
		"GPL-2.0-or-later"
	],
	"authors": [
		{
			"name": "TYPO3 Core Team",
			"email": "typo3cms@typo3.org",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://forge.typo3.org/issues/",
		"forum": "https://talk.typo3.org/",
		"source": "https://github.com/TYPO3/typo3/",
		"docs": "https://docs.typo3.org/c/typo3/cms-hub/main/en-us/",
		"rss": "https://news.typo3.com/rss/",
		"chat": "https://typo3.community/meet/slack/",
		"security": "https://typo3.org/security/"
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"require": {
		"php": "^8.2",
		"typo3/cms-backend": "^14.3.9",
		"typo3/cms-core": "^14.3.9",
		"league/oauth2-server": "^9.3",
		"justinrainbow/json-schema": "^6.8",
		"devizzent/cebe-php-openapi": "^1.1"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.95",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11.5 || ^12.1",
		"saschaegerer/phpstan-typo3": "^3.0",
		"typo3/cms-filelist": "^14.3",
		"typo3/cms-seo": "^14.3",
		"typo3/cms-workspaces": "^14.3",
		"typo3/coding-standards": "^0.9",
		"typo3/testing-framework": "^9.7"
	},
	"conflict": {
		"typo3/cms": "*"
	},
	"extra": {
		"typo3/cms": {
			"t3g-product": "suite",
			"version": "14.3.0",
			"extension-key": "hub",
			"web-dir": ".Build/public"
		}
	},
	"autoload": {
		"classmap": [
			"src/"
		],
		"psr-4": {
			"TYPO3\\CMS\\Hub\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"TYPO3\\CMS\\Backend\\Tests\\": "Tests/Backend/",
			"TYPO3\\CMS\\Core\\Tests\\": "Tests/Core/",
			"TYPO3\\CMS\\Hub\\Tests\\": "Tests/",
			"TYPO3Tests\\TestAction\\": "Tests/Functional/Fixtures/Extensions/test_action/Classes/",
			"TYPO3Tests\\TestIrreForeignfield\\": "Tests/Core/Functional/Fixtures/Extensions/test_irre_foreignfield/Classes/"
		}
	}
}
