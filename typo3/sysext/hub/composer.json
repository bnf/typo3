{
	"name": "typo3-suite/hub",
	"type": "typo3-cms-extension",
	"description": "TYPO3 CMS Hub - API for TYPO3",
	"homepage": "https://typo3.community/",
	"funding": [
		{
			"type": "membership",
			"url": "https://typo3.org/membership"
		}
	],
	"license": [
		"GPL-2.0-or-later"
	],
	"authors": [
		{
			"name": "TYPO3 Core Team",
			"email": "typo3cms@typo3.org",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://forge.typo3.org/issues/",
		"forum": "https://talk.typo3.org/",
		"source": "https://github.com/TYPO3/typo3/",
		"docs": "https://docs.typo3.org/c/typo3/cms-hub/main/en-us/",
		"rss": "https://news.typo3.com/rss/",
		"chat": "https://typo3.community/meet/slack/",
		"security": "https://typo3.org/security/"
	},
	"config": {
		"sort-packages": true
	},
	"require": {
		"typo3/cms-core": "^14.3",
		"league/oauth2-server": "^9.3",
		"justinrainbow/json-schema": "^6.8",
		"devizzent/cebe-php-openapi": "^1.1"
	},
	"conflict": {
		"typo3/cms": "*"
	},
	"extra": {
		"typo3/cms": {
			"t3g-product": "suite",
			"version": "14.3.0",
			"extension-key": "hub"
		}
	},
	"autoload": {
		"classmap": [
			"src/"
		],
		"psr-4": {
			"TYPO3\\CMS\\Hub\\": "Classes/"
		}
	}
}
