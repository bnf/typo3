{
	"name": "typo3-suite/hub",
	"type": "typo3-cms-extension",
	"description": "TYPO3 API Hub: a REST API with apps, OAuth 2.0 and scopes",
	"homepage": "https://api-hub.typo3.com/",
	"license": [
		"GPL-2.0-or-later"
	],
	"authors": [
		{
			"name": "TYPO3 GmbH",
			"email": "support@typo3.com",
			"homepage": "https://typo3.com",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@typo3.com",
		"docs": "https://api-hub.typo3.com/",
		"security": "https://typo3.org/.well-known/security.txt"
	},
	"config": {
		"sort-packages": true
	},
	"require": {
		"php": "^8.2",
		"typo3/cms-backend": "^14.3.9",
		"typo3/cms-core": "^14.3.9",
		"league/oauth2-server": "^9.3",
		"justinrainbow/json-schema": "^6.8",
		"devizzent/cebe-php-openapi": "^1.1.3"
	},
	"conflict": {
		"typo3/cms": "*"
	},
	"extra": {
		"typo3/cms": {
			"t3g-product": "suite",
			"version": "14.3.0",
			"extension-key": "hub"
		}
	},
	"autoload": {
		"classmap": [
			"src/"
		],
		"psr-4": {
			"TYPO3\\CMS\\Hub\\": "Classes/"
		}
	}
}
